<Bindings>
    <!-- Shows every faded part of Daylight UI, or sends it back to its fade (Fade.ToggleShowAll). Named in Fade.lua. -->
    <Binding name="DAYLIGHTUI_SHOWALL" category="BINDING_HEADER_DAYLIGHTUI">
        if DaylightUI and DaylightUI.FadeShowAll then DaylightUI.FadeShowAll() end
    </Binding>
</Bindings>
